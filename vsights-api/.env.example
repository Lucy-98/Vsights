# Sao chép thành .env rồi điền. KHÔNG đưa tệp .env lên Project hay repo.
# DSN PostgreSQL (psycopg 3). Có mật khẩu: postgresql+psycopg://postgres:MAT_KHAU@localhost:5432/vsights
# Không ghi mật khẩu trong DSN thì psycopg tự đọc biến môi trường PGPASSWORD.
VS_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/vsights
# Khoá ký JWT, tối thiểu 32 ký tự. Tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(40))"
VS_JWT_SECRET=
# Đặt false CHỈ khi chạy máy cá nhân bằng Safari mà tải lại trang bị đăng xuất
VS_COOKIE_SECURE=true
